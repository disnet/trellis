{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trellis",
  "version": "0.1.0",
  "identifier": "com.trellis.desktop",
  "build": {
    "beforeDevCommand": "npm run desktop:prepare",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "resources": {
      "runtime/": "runtime/"
    },
    "macOS": {
      "minimumSystemVersion": "13.5"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
